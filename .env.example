# Mode of operation: 'mock' (stateful sandbox simulation) or 'live' (Qualys ETM API integration)
QUALYS_API_MODE=mock

# Live Qualys API settings (Required if QUALYS_API_MODE=live)
QUALYS_ETM_API_URL=https://api.qualys.com
QUALYS_ETM_API_KEY=your_qualys_api_token_here

# Governance Settings
GOVERNANCE_MATRIX_PATH=governance_matrix.json
